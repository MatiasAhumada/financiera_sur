generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  LOST
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model AdminUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  passwordHash String
  role      String   @default("ADMIN")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions  AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  @@index([userId, expiresAt])
}

model FinancingPlan {
  id          String   @id @default(cuid())
  name        String
  description String
  active      Boolean  @default(true)
  displayOrder Int     @default(0)
  products    ProductFinancing[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id           String              @id @default(cuid())
  name         String
  slug         String              @unique
  description  String
  published    Boolean             @default(false)
  featured     Boolean             @default(false)
  displayOrder Int                 @default(0)
  images       ProductImage[]
  financings   ProductFinancing[]
  inquiries    Inquiry[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model ProductFinancing {
  productId       String
  financingPlanId String
  displayOrder    Int @default(0)
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  financingPlan   FinancingPlan @relation(fields: [financingPlanId], references: [id], onDelete: Cascade)
  @@id([productId, financingPlanId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  objectKey   String   @unique
  width       Int
  height      Int
  bytes       Int
  alt         String
  displayOrder Int     @default(0)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Inquiry {
  id                    String             @id @default(cuid())
  productId             String?
  name                  String
  email                 String
  phone                 String
  message               String?
  source                String             @default("website")
  consentAt             DateTime
  status                InquiryStatus      @default(NEW)
  notificationStatus    NotificationStatus @default(PENDING)
  notificationAttempts  Int                @default(0)
  lastNotificationError String?
  product               Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  @@index([status, createdAt])
  @@index([productId])
}
